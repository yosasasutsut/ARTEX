@@ -13,7 +13,9 @@
 # ---------------------------------------------------------------- frontend ---
 # Pinned to the Node 22 line the CI/release workflows use. On the build platform
 # only; the frontend static export is architecture-independent.
-FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS web
+# Base images are pinned by digest (hardening pass): the tag is kept for readability,
+# the digest is what is pulled. Refresh with `docker buildx imagetools inspect <image:tag>`.
+FROM --platform=$BUILDPLATFORM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS web
 ENV NEXT_TELEMETRY_DISABLED=1
 WORKDIR /src/web
 COPY web/package.json web/package-lock.json ./
@@ -25,7 +27,7 @@ RUN npm run build:static
 # Pinned to the Go 1.26 line (matches go.mod and the release binaries job). The
 # binary is CGO-free, so this stage runs on the build platform and cross-compiles
 # to $TARGETARCH without QEMU.
-FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS build
+FROM --platform=$BUILDPLATFORM golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS build
 WORKDIR /src
 COPY go.mod go.sum ./
 RUN go mod download
@@ -66,7 +68,7 @@ RUN ARTEX_SKIP_FRONTEND=1 \
 #
 # sqlmap has no release binaries: it is a shallow clone of a pinned tag, checked
 # against the expected commit, which is the same idea.
-FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS tools
+FROM --platform=$BUILDPLATFORM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS tools
 ARG TARGETARCH
 ARG NUCLEI_VERSION=v3.11.1
 ARG NUCLEI_SHA256_AMD64=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6
@@ -133,7 +135,7 @@ RUN set -eux; \
     rm -rf /opt/sqlmap/.git
 
 # ---------------------------------------------------------------- runtime ---
-FROM python:3.12-slim-bookworm
+FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
 ARG TARGETARCH
 # Common tools: ripgrep / curl / vim, plus a set of recon staples (add/remove as needed).
 RUN apt-get update && apt-get install -y --no-install-recommends \
@@ -177,9 +179,15 @@ RUN set -eux; \
 # would fail under a program's egress allowlist.
 ARG BBOT_VERSION=3.0.2
 # arm64: bbot's Chrome and retirejs's Node are x86-64; use native builds.
+# bbot and its Python dependencies install from a hash-locked requirements file
+# (hardening pass): pip refuses any file whose SHA-256 is not listed. Regenerate
+# hardening/build/bbot-requirements.txt with pip-compile --generate-hashes on upgrade.
+COPY hardening/build/bbot-requirements.txt /tmp/bbot-requirements.txt
 RUN set -eux; \
+    grep -q "^bbot==${BBOT_VERSION} " /tmp/bbot-requirements.txt; \
     python -m venv /opt/bbot; \
-    /opt/bbot/bin/pip install --no-cache-dir "bbot==${BBOT_VERSION}"; \
+    /opt/bbot/bin/pip install --no-cache-dir --require-hashes -r /tmp/bbot-requirements.txt; \
+    rm -f /tmp/bbot-requirements.txt; \
     ln -s /opt/bbot/bin/bbot /usr/local/bin/bbot; \
     if [ "${TARGETARCH:-amd64}" = "arm64" ]; then \
       apt-get update; \
@@ -215,7 +223,14 @@ ARG PLAYWRIGHT_VERSION=1.64.1
 # playwright-core's exports map hides cli.js from require.resolve, so run the
 # binary npm links for @playwright/mcp instead: it is the copy MCP actually
 # loads, and it installs the Chromium revision that copy expects.
-RUN npm install -g "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION}" "@playwright/cli@${PLAYWRIGHT_CLI_VERSION}" "playwright@${PLAYWRIGHT_VERSION}" \
+# The global install goes through verify-npm-global.mjs (hardening pass): each
+# package and dependency is fetched, checked against the sha512 pinned in
+# hardening/build/npm-global-pins.txt, and after the install every file on disk is compared
+# with those verified tarballs. An unpinned or altered package fails the build.
+COPY hardening/build/verify-npm-global.mjs hardening/build/npm-global-pins.txt /tmp/npmverify/
+RUN node /tmp/npmverify/verify-npm-global.mjs /tmp/npmverify/npm-global-pins.txt \
+      "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION}" "@playwright/cli@${PLAYWRIGHT_CLI_VERSION}" "playwright@${PLAYWRIGHT_VERSION}" \
+    && rm -rf /tmp/npmverify \
     && playwright-cli --help \
     && playwright install --with-deps chromium \
     && "$(npm root -g)/@playwright/mcp/node_modules/.bin/playwright-core" install chromium \

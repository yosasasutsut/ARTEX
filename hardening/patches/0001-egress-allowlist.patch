@@ -0,0 +1,79 @@
+package notify
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/Autumn-27/artex/hardening/allowlist"
+)
+
+// The shared delivery client must refuse a receiver that is not on the
+// control-plane allowlist, before any connection is opened.
+func TestAllowlistGuardsHTTPDelivery(t *testing.T) {
+	t.Setenv(AllowLocalTargetsEnv, "1") // the fake receiver is on loopback
+	var hits atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer srv.Close()
+
+	prev := allowlist.SetActiveAllowlist(allowlist.ParseAllowlist("enforce", "hooks.example.com"))
+	defer allowlist.SetActiveAllowlist(prev)
+
+	req, _ := http.NewRequest(http.MethodPost, srv.URL, strings.NewReader("{}"))
+	if _, err := httpClient.Do(req); err == nil || !strings.Contains(err.Error(), "not in the allowlist") {
+		t.Fatalf("delivery to an unlisted host: err=%v, want an allowlist refusal", err)
+	}
+	if hits.Load() != 0 {
+		t.Fatal("the receiver was contacted despite the allowlist")
+	}
+
+	allowlist.SetActiveAllowlist(allowlist.ParseAllowlist("enforce", "127.0.0.1"))
+	req, _ = http.NewRequest(http.MethodPost, srv.URL, strings.NewReader("{}"))
+	resp, err := httpClient.Do(req)
+	if err != nil {
+		t.Fatalf("delivery to a listed host: %v", err)
+	}
+	resp.Body.Close()
+	if hits.Load() != 1 {
+		t.Fatalf("receiver hits = %d, want 1", hits.Load())
+	}
+}
+
+// SMTP is not an HTTP round trip: the allowlist is checked before the dial.
+func TestAllowlistGuardsSMTPDial(t *testing.T) {
+	t.Setenv(AllowLocalTargetsEnv, "1")
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	var accepted atomic.Int32
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			accepted.Add(1)
+			c.Close()
+		}
+	}()
+
+	prev := allowlist.SetActiveAllowlist(allowlist.ParseAllowlist("enforce", "smtp.example.com"))
+	defer allowlist.SetActiveAllowlist(prev)
+
+	_, err = emailDial(context.Background(), ln.Addr().String(), "mail.unlisted.example", false)
+	if err == nil || !strings.Contains(err.Error(), "not in the allowlist") {
+		t.Fatalf("SMTP to an unlisted host: err=%v, want an allowlist refusal", err)
+	}
+	if accepted.Load() != 0 {
+		t.Fatal("the SMTP server was dialled despite the allowlist")
+	}
+}

+++ b/server/search_egress_test.go
@@ -0,0 +1,40 @@
+package server
+
+import (
+	"testing"
+
+	"github.com/Autumn-27/artex/hardening/allowlist"
+)
+
+// The search tool owns its HTTP client, so the control-plane allowlist is
+// applied to the backend's endpoint before the tool is handed to an agent.
+func TestSearchEgressCheck(t *testing.T) {
+	prev := allowlist.SetActiveAllowlist(allowlist.ParseAllowlist("off", ""))
+	defer allowlist.SetActiveAllowlist(prev)
+
+	for backend := range searchBackendEndpoints {
+		if err := searchEgressCheck(backend, ""); err != nil {
+			t.Errorf("off: backend %q refused: %v", backend, err)
+		}
+	}
+
+	allowlist.SetActiveAllowlist(allowlist.ParseAllowlist("enforce", "api.tavily.com api.deepseek.com"))
+	cases := []struct {
+		backend, deepSeekBase string
+		ok                    bool
+	}{
+		{"tavily", "", true},
+		{"brave-free", "", false},
+		{"ddgs", "", false},
+		{"keenable", "", false},
+		{deepSeekWebSearchBackend, "https://api.deepseek.com/anthropic", true},
+		{deepSeekWebSearchBackend, "https://other.example/v1", false},
+		{deepSeekWebSearchBackend, "", false}, // no active profile: nothing to approve
+		{"unknown-backend", "", false},        // no known endpoint: refused while enforcing
+	}
+	for _, c := range cases {
+		if err := searchEgressCheck(c.backend, c.deepSeekBase); (err == nil) != c.ok {
+			t.Errorf("searchEgressCheck(%q, %q) err=%v, want allowed=%v", c.backend, c.deepSeekBase, err, c.ok)
+		}
+	}
+}

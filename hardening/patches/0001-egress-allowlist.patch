+package archivestore
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/Autumn-27/artex/hardening/allowlist"
+)
+
+// An archive endpoint that is not on the control-plane allowlist must not
+// receive the upload.
+func TestAllowlistGuardsArchiveUpload(t *testing.T) {
+	var hits atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	store, err := New(Config{Endpoint: srv.URL, Region: "us-east-1", Bucket: "test-bucket", Prefix: "test/tasks", AccessKey: "test", SecretKey: "test", PathStyle: true})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	data := []byte("archive payload")
+	sum := sha256.Sum256(data)
+	checksum := hex.EncodeToString(sum[:])
+	source := filepath.Join(t.TempDir(), "a.tar.zst")
+	if err := os.WriteFile(source, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	prev := allowlist.SetActiveAllowlist(allowlist.ParseAllowlist("enforce", "s3.example.com"))
+	defer allowlist.SetActiveAllowlist(prev)
+
+	err = store.Upload(context.Background(), store.URI(1, 2, checksum), source, checksum)
+	if err == nil || !strings.Contains(err.Error(), "not in the allowlist") {
+		t.Fatalf("upload to an unlisted endpoint: err=%v, want an allowlist refusal", err)
+	}
+	if hits.Load() != 0 {
+		t.Fatalf("the archive endpoint was contacted %d time(s) despite the allowlist", hits.Load())
+	}
+}

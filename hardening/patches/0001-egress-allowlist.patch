+package mcphttp
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Autumn-27/artex/hardening/allowlist"
+)
+
+// An MCP server that is not on the control-plane allowlist must not be contacted,
+// on either transport.
+func TestAllowlistGuardsMCPClients(t *testing.T) {
+	var hits atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer srv.Close()
+
+	prev := allowlist.SetActiveAllowlist(allowlist.ParseAllowlist("enforce", "mcp.example.com"))
+	defer allowlist.SetActiveAllowlist(prev)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+
+	if _, err := New(ctx, "t", srv.URL, nil, false, 5); err == nil || !strings.Contains(err.Error(), "not in the allowlist") {
+		t.Errorf("streamable HTTP to an unlisted host: err=%v, want an allowlist refusal", err)
+	}
+	if _, err := NewSSE(ctx, "t", srv.URL+"/sse", nil, false); err == nil || !strings.Contains(err.Error(), "not in the allowlist") {
+		t.Errorf("SSE to an unlisted host: err=%v, want an allowlist refusal", err)
+	}
+	// The insecure-TLS branch builds its own transport; it must be guarded too.
+	if _, err := New(ctx, "t", srv.URL, nil, true, 5); err == nil || !strings.Contains(err.Error(), "not in the allowlist") {
+		t.Errorf("insecure streamable HTTP to an unlisted host: err=%v, want an allowlist refusal", err)
+	}
+	if hits.Load() != 0 {
+		t.Fatalf("the MCP server was contacted %d time(s) despite the allowlist", hits.Load())
+	}
+}

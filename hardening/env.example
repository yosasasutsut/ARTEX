# Settings added by the hardening folder. Append the ones you need to the .env
# next to docker-compose.yml (start from the upstream .env.example).

# --- In-program control-plane allowlist --------------------------------------
# Needs an image built with hardening/build.sh (it applies the allowlist patch).
# Restricts the fixed, operator-owned clients (LLM provider, model list, web
# search, notifications, S3 archive, MCP servers, update check) to hosts you
# approve. It does NOT touch the pentest data plane (scan targets).
#   ARTEX_EGRESS_MODE: off (default) | audit (log only, blocks nothing) | enforce.
#     A value that is set but misspelled enforces.
#   ARTEX_EGRESS_ALLOW: comma/space list of hosts; a parent domain admits its
#     subdomains. A local Ollama or MCP server needs 127.0.0.1 / localhost here.
# Start with audit to see what gets flagged, then switch to enforce.
ARTEX_EGRESS_MODE=enforce
ARTEX_EGRESS_ALLOW=api.anthropic.com

# --- Network firewall (hardening/docker-compose.hardened.yml) -----------------
# Binds everything in the container, including agent shell commands and the
# bundled scanners, which the in-program allowlist cannot see.
#   ARTEX_FW_ALLOW_HOSTS: control-plane hosts, TCP 80/443, reachable by the server
#     process only (not by agent shells). Default: ARTEX_EGRESS_ALLOW.
#   ARTEX_FW_TARGETS: the systems you are authorised to test: IPs, CIDRs or host
#     names, any protocol. Empty = the scanner can reach no target at all.
#   ARTEX_FW_DNS: filter (default) answers DNS only for the names above and their
#     subdomains, which stops DNS tunnelling; open leaves Docker's resolver as is.
#   ARTEX_FW_DNS_ALLOW: extra names the DNS filter may resolve.
#   ARTEX_FW_REFRESH: seconds between re-resolving host names (default 60).
# ARTEX_FW_ALLOW_HOSTS=api.anthropic.com
ARTEX_FW_TARGETS=
# ARTEX_FW_DNS=filter
# ARTEX_FW_DNS_ALLOW=
